---
import { site } from '../../consts';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisiblePosts } from '../../lib/posts';

const posts = await getVisiblePosts();
---

<BaseLayout title={site.blogHeading} description={site.blogDescription}>
	<header class="page-header">
		<h1>{site.blogHeading}</h1>
		<p class="count">{site.blogDescription && site.blogDescription !== site.blogHeading ? `${site.blogDescription} · ` : ''}共 {posts.length} 篇</p>
	</header>
	<PostList posts={posts} />
</BaseLayout>
<style>
	.page-header {
		margin-bottom: 2.4rem;
	}
	h1 {
		font-size: 2.1rem;
		margin-bottom: 0.5rem;
	}
	.count {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin: 0;
	}
</style>
