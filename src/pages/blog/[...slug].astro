---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getVisiblePosts, readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getVisiblePosts();
	// posts 按时间从新到旧排列：前一项更新，后一项更早
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}
type Props = { post: CollectionEntry<'blog'>; newer?: CollectionEntry<'blog'>; older?: CollectionEntry<'blog'> };

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const link = (p?: CollectionEntry<'blog'>) => (p ? { href: `/blog/${p.id}/`, title: p.data.title } : undefined);
---

<BlogPost {...post.data} headings={headings} minutes={readingMinutes(post.body)} newer={link(newer)} older={link(older)}>
	<Content />
</BlogPost>
