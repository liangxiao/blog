---
import { getEntry, render } from 'astro:content';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE, site } from '../consts';
import { getVisiblePosts } from '../lib/posts';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('缺少首页介绍');
const { Content } = await render(entry);
const all = await getVisiblePosts();
const posts = all.slice(0, site.latestCount);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		{site.homeCover && <img class="home-cover" src={site.homeCover} alt={`${SITE_TITLE} 首页封面`} width="1200" loading="eager" />}
		<div class="greeting">
			{site.avatar && <img class="avatar" src={site.avatar} alt={site.author} width="64" height="64" />}
			<h1>{site.homeHeading}</h1>
		</div>
		<div class="prose lead"><Content /></div>
	</section>
	<section>
		<h2 class="section-title"><span>{site.latestHeading}</span></h2>
		<PostList posts={posts} />
		{all.length > posts.length && <p class="more"><a href="/blog">{site.allPostsText}</a></p>}
	</section>
</BaseLayout>
<style>
	.home-cover {
		width: 100%;
		height: auto;
		margin-bottom: 2rem;
	}
	.intro {
		margin-bottom: 3.5rem;
	}
	.greeting {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.greeting h1 {
		margin: 0;
		font-size: 2.4rem;
		letter-spacing: 0.06em;
	}
	.avatar {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		object-fit: cover;
	}
	.lead {
		font-size: 1.04em;
		color: var(--text);
	}
	.lead :global(p:last-child) {
		margin-bottom: 0;
	}
	.section-title {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0 0 1.4rem;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		color: var(--text-muted);
	}
	.section-title::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--border);
	}
	.more {
		margin-top: 1rem;
		font-size: 0.92rem;
	}
</style>
