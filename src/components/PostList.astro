---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---

{posts.length === 0 ? (
	<p class="empty">还没有文章，快去写第一篇吧。</p>
) : (
	<ul class="post-list">
		{posts.map((post) => (
			<li>
				<a class="post-link" href={`/blog/${post.id}/`}>
					{post.data.heroImage && (
						<Image
							class="thumb"
							src={post.data.heroImage}
							alt=""
							width={720}
							height={405}
							loading="lazy"
							quality={80}
						/>
					)}
					<div class="body">
						<h3>{post.data.title}</h3>
						<p class="meta">
							<FormattedDate date={post.data.pubDate} />
							{post.data.tags.length > 0 && (
								<span class="tags">{post.data.tags.map((t) => <span class="tag">#{t}</span>)}</span>
							)}
						</p>
						<p class="desc">{post.data.description}</p>
					</div>
				</a>
			</li>
		))}
	</ul>
)}
<style>
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.post-list li {
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--border);
	}
	.post-link {
		display: grid;
		grid-template-columns: 160px 1fr;
		gap: 1rem;
		align-items: start;
		text-decoration: none;
		color: inherit;
	}
	.post-link:not(:has(.thumb)) {
		grid-template-columns: 1fr;
	}
	.thumb {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--bg-soft);
	}
	h3 {
		margin: 0 0 0.35rem;
		font-size: 1.2rem;
		color: var(--text-strong);
	}
	.post-link:hover h3 {
		color: var(--accent);
	}
	.meta {
		margin: 0 0 0.35rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.tag {
		margin-right: 0.5rem;
	}
	.desc {
		margin: 0;
		color: var(--text);
		font-size: 0.95rem;
	}
	.empty {
		color: var(--text-muted);
	}
	@media (max-width: 640px) {
		.post-link {
			grid-template-columns: 1fr;
		}
		.thumb {
			max-width: 100%;
		}
	}
</style>
