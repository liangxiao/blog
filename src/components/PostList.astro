---
import { site } from '../consts';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;

// 按年份分组，像书的目录
const shanghai = (date: Date, options: Intl.DateTimeFormatOptions) =>
	new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', ...options }).format(date);
const groups = new Map<string, CollectionEntry<'blog'>[]>();
for (const post of posts) {
	const year = shanghai(post.data.pubDate, { year: 'numeric' }).replace(/\D/g, '');
	groups.set(year, [...(groups.get(year) ?? []), post]);
}
const day = (date: Date) => {
	const [m, d] = shanghai(date, { month: '2-digit', day: '2-digit' }).match(/\d+/g) ?? [];
	return `${m}·${d}`;
};
---

{posts.length === 0 ? (
	<p class="empty">还没有文章，快去写第一篇吧。</p>
) : (
	<div class="toc">
		{[...groups].map(([year, items]) => (
			<section class="year">
				<h3 class="year-label">{year}</h3>
				<ol>
					{items.map((post) => (
						<li>
							<a class="entry" href={`/blog/${post.id}/`}>
								{site.showDates && <time datetime={post.data.pubDate.toISOString()}>{day(post.data.pubDate)}</time>}
								<span class="body">
									<span class="title">{post.data.title}</span>
									{post.data.description && <span class="desc">{post.data.description}</span>}
									{site.showTags && post.data.tags.length > 0 && (
										<span class="tags">{post.data.tags.map((t) => <span>#{t}</span>)}</span>
									)}
								</span>
								{site.showListCovers && post.data.heroImage && typeof post.data.heroImage !== 'string' && (
									<Image class="thumb" src={post.data.heroImage} alt="" width={240} height={160} loading="lazy" quality={80} />
								)}
								{site.showListCovers && typeof post.data.heroImage === 'string' && (
									<img class="thumb" src={post.data.heroImage} alt="" width="240" height="160" loading="lazy" />
								)}
							</a>
						</li>
					))}
				</ol>
			</section>
		))}
	</div>
)}
<style>
	.year {
		display: grid;
		grid-template-columns: 4.5rem 1fr;
		gap: 0 1rem;
		padding: 1.4rem 0 0.6rem;
		border-top: 1px solid var(--border);
	}
	.year:first-child {
		border-top: none;
		padding-top: 0.4rem;
	}
	.year-label {
		margin: 0.2rem 0 0;
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 600;
		color: var(--text-muted);
		letter-spacing: 0.06em;
	}
	ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li + li {
		margin-top: 0.4rem;
	}
	.entry {
		display: grid;
		grid-template-columns: 3.4rem 1fr auto;
		gap: 1rem;
		align-items: start;
		padding: 0.5rem 0 0.9rem;
		color: inherit;
		text-decoration: none;
	}
	.entry:not(:has(time)) {
		grid-template-columns: 1fr auto;
	}
	time {
		padding-top: 0.15rem;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
		letter-spacing: 0;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}
	.title {
		font-family: var(--font-display);
		font-size: 1.12rem;
		font-weight: 600;
		line-height: 1.5;
		color: var(--text-strong);
		transition: color 0.15s;
	}
	.entry:hover .title {
		color: var(--accent);
	}
	.desc {
		font-size: 0.92rem;
		line-height: 1.7;
		color: var(--text-muted);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.75rem;
		font-size: 0.8rem;
		color: var(--text-muted);
	}
	.thumb {
		width: 96px;
		height: 64px;
		object-fit: cover;
		border-radius: 3px;
		border: 1px solid var(--border);
		background: var(--bg-soft);
		filter: saturate(0.85);
		margin-top: 0.3rem;
	}
	.empty {
		color: var(--text-muted);
	}
	@media (max-width: 640px) {
		.year {
			grid-template-columns: 1fr;
		}
		.year-label {
			margin-bottom: 0.4rem;
		}
		.entry {
			grid-template-columns: 3rem 1fr;
			gap: 0.75rem;
		}
		.thumb {
			display: none;
		}
	}
</style>
