---
import { AUTHOR } from '../consts';
const year = new Date().getFullYear();
---

<footer>
	<p>© {year} {AUTHOR} · <a href="/rss.xml">RSS 订阅</a> · 由 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建</p>
</footer>
<style>
	footer {
		max-width: 760px;
		margin: 4rem auto 0;
		padding: 2rem 1.25rem 3rem;
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		font-size: 0.85rem;
		text-align: center;
	}
	footer a {
		color: inherit;
	}
</style>
