---
import { site } from '../consts';
---
{site.commentsEnabled && !import.meta.env.DEV && (
 <section aria-label="文章评论">
  <h2>评论</h2>
  <script is:inline src="https://giscus.app/client.js"
   data-repo={site.giscusRepo} data-repo-id={site.giscusRepoId}
   data-category-id={site.giscusCategoryId} data-mapping="pathname" data-strict="1"
   data-reactions-enabled="1" data-input-position="top" data-theme="preferred_color_scheme"
   data-lang="zh-CN" data-loading="lazy" crossorigin="anonymous" async></script>
 </section>
)}
