---
// 文章目录：只在有 3 个以上二级标题时出现。
// 窄屏是正文前一个可折叠的「目录」；宽屏固定在正文左侧，并高亮当前读到的章节。
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
const show = items.filter((h) => h.depth === 2).length >= 3;
---

{show && (
	<nav class="toc" aria-label="文章目录">
		<details>
			<summary>目录</summary>
			<ol>
				{items.map((h) => (
					<li class={`depth-${h.depth}`}>
						<a href={`#${h.slug}`}>{h.text}</a>
					</li>
				))}
			</ol>
		</details>
	</nav>
)}

<script>
	const toc = document.querySelector<HTMLElement>('nav.toc');
	if (toc) {
		const details = toc.querySelector('details')!;
		const wide = matchMedia('(min-width: 1180px)');
		const sync = () => { if (wide.matches) details.open = true; };
		sync();
		wide.addEventListener('change', sync);

		const links = new Map([...toc.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
		const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
		let current: HTMLAnchorElement | undefined;
		const mark = () => {
			// 当前章节 = 最后一个已经滚过视口上方 1/4 处的标题
			const line = innerHeight * 0.25;
			const passed = targets.filter((el) => el.getBoundingClientRect().top <= line);
			const active = links.get((passed.at(-1) ?? targets[0])?.id);
			if (active === current) return;
			current?.removeAttribute('aria-current');
			active?.setAttribute('aria-current', 'true');
			current = active;
		};
		addEventListener('scroll', () => requestAnimationFrame(mark), { passive: true });
		mark();
		// 窄屏点击目录项后收起
		toc.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a') && !wide.matches) details.open = false; });
	}
</script>

<style>
	.toc {
		margin: 0 0 2.4rem;
		font-size: 0.9rem;
	}
	details {
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		padding: 0.6rem 0;
	}
	summary {
		cursor: pointer;
		list-style: none;
		font-family: var(--font-display);
		color: var(--text-muted);
		letter-spacing: 0.2em;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary::after {
		content: ' ＋';
		letter-spacing: 0;
	}
	details[open] summary::after {
		content: ' －';
	}
	ol {
		list-style: none;
		margin: 0.6rem 0 0.2rem;
		padding: 0;
	}
	li {
		margin: 0.15rem 0;
		line-height: 1.55;
	}
	li.depth-3 {
		padding-left: 1.2em;
		font-size: 0.95em;
	}
	a {
		display: block;
		padding: 0.2rem 0 0.2rem 0.75rem;
		border-left: 2px solid transparent;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.15s, border-color 0.15s;
	}
	a:hover {
		color: var(--text-strong);
	}
	a[aria-current] {
		color: var(--text-strong);
		border-left-color: var(--accent);
	}

	/* 宽屏：固定在正文左侧的留白里 */
	@media (min-width: 1180px) {
		.toc {
			position: fixed;
			top: 8rem;
			left: max(1.5rem, calc(50% - var(--measure) / 2 - 15rem));
			width: 12.5rem;
			max-height: calc(100vh - 10rem);
			overflow-y: auto;
			margin: 0;
			font-size: 0.82rem;
		}
		details {
			border: none;
			padding: 0;
		}
		summary {
			pointer-events: none;
			margin-bottom: 0.4rem;
		}
		summary::after,
		details[open] summary::after {
			content: none;
		}
	}
	@media print {
		.toc {
			display: none;
		}
	}
</style>
