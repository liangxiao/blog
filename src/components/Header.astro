---
import { SITE_TITLE, site } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<div class="links">
			{site.navigation.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
			{site.showRss && <a href="/rss.xml" title="RSS 订阅">RSS</a>}
		</div>
	</nav>
</header>
<style>
	nav {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 1.6rem 1.5rem 0;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.6rem 1.5rem;
		flex-wrap: wrap;
	}
	nav::after {
		content: '';
		flex-basis: 100%;
		height: 1px;
		margin-top: 1.1rem;
		background: var(--border);
	}
	.site-title {
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: 1.08rem;
		letter-spacing: 0.04em;
		color: var(--text-strong);
		text-decoration: none;
	}
	.links {
		display: flex;
		gap: 1.4rem;
		align-items: baseline;
		font-size: 0.92rem;
	}
	.links a {
		color: var(--text-muted);
		text-decoration: none;
		padding-bottom: 0.15rem;
		border-bottom: 1.5px solid transparent;
		transition: color 0.15s, border-color 0.15s;
	}
	.links a:hover {
		color: var(--text-strong);
	}
	.links :global(a.active) {
		color: var(--text-strong);
		border-bottom-color: var(--accent);
	}
	@media (max-width: 640px) {
		nav {
			padding-top: 1.2rem;
		}
		.links {
			gap: 1.1rem;
		}
	}
</style>
