---
import { site } from '../consts';
import Comments from '../components/Comments.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, draft, tags = [] } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage || site.defaultCover}>
	<article>
		{import.meta.env.DEV && draft && <p class="draft" role="status">草稿预览 · 正式网站不会显示此文章</p>}
		<header class="post-header">
			<h1>{title}</h1>
			{description && <p class="subtitle">{description}</p>}
			<p class="meta">
				{site.showDates && <FormattedDate date={pubDate} />}
				{site.showDates && updatedDate && <span>更新于 <FormattedDate date={updatedDate} /></span>}
				{site.showTags && tags.length > 0 && <span class="tags">{tags.map((t) => <span>#{t}</span>)}</span>}
			</p>
		</header>
		{
			site.showArticleCover && heroImage && typeof heroImage !== 'string' && (
				<Image
					class="hero"
					width={1020}
					height={574}
					src={heroImage}
					alt={`${title} 封面`}
					loading="eager"
					fetchpriority="high"
					quality={85}
				/>
			)
		}
		{site.showArticleCover && (typeof heroImage === 'string' || (!heroImage && site.defaultCover)) && <img class="hero" src={typeof heroImage === 'string' ? heroImage : site.defaultCover} alt={`${title} 封面`} width="1020" loading="eager" />}
		<div class="prose">
			<slot />
		</div>
		<p class="fin" aria-hidden="true">（完）</p>
		<Comments />
		<p class="back"><a href="/blog">← 全部文章</a></p>
	</article>
</BaseLayout>
<style>
	.draft {
		font-size: 0.85rem;
		color: var(--accent);
		border: 1px dashed var(--accent);
		padding: 0.3rem 0.8rem;
		border-radius: var(--radius);
		display: inline-block;
	}
	.post-header {
		margin-bottom: 2.2rem;
	}
	.post-header h1 {
		font-size: 2.2rem;
		margin-bottom: 0.8rem;
	}
	.subtitle {
		font-family: var(--font-serif);
		font-size: 1.08rem;
		line-height: 1.7;
		color: var(--text-muted);
		margin: 0 0 1rem;
	}
	.meta {
		color: var(--text-muted);
		font-size: 0.85rem;
		margin: 0;
		display: flex;
		gap: 0.4rem 1.2rem;
		flex-wrap: wrap;
	}
	.tags {
		display: inline-flex;
		gap: 0.75rem;
	}
	.hero {
		display: block;
		width: 100%;
		height: auto;
		margin: 0 0 2.6rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-soft);
	}
	.fin {
		margin: 3rem 0 0;
		text-align: center;
		font-family: var(--font-serif);
		color: var(--text-muted);
		letter-spacing: 0.2em;
	}
	.back {
		margin-top: 3rem;
		font-size: 0.92rem;
	}
	@media (max-width: 640px) {
		.post-header h1 {
			font-size: 1.75rem;
		}
	}
</style>
