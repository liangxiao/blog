---
import { site } from '../consts';
import Comments from '../components/Comments.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, draft, tags = [] } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage || site.defaultCover}>
	<article>
        {import.meta.env.DEV && draft && <p role="status">📝 草稿预览 · 正式网站不会显示此文章</p>}
		<header class="post-header">
			<h1>{title}</h1>
			<p class="meta">
				{site.showDates && <FormattedDate date={pubDate} />}
				{site.showDates && updatedDate && <span>· 更新于 <FormattedDate date={updatedDate} /></span>}
				{site.showTags && tags.length > 0 && <span>· {tags.map((t) => `#${t}`).join(' ')}</span>}
			</p>
		</header>
		{
			site.showArticleCover && heroImage && typeof heroImage !== 'string' && (
				<Image
					class="hero"
					width={1020}
					height={574}
					src={heroImage}
					alt={`${title} 封面`}
					loading="eager"
					fetchpriority="high"
					quality={85}
				/>
			)
		}
		{site.showArticleCover && (typeof heroImage === 'string' || (!heroImage && site.defaultCover)) && <img class="hero" src={typeof heroImage === 'string' ? heroImage : site.defaultCover} alt={`${title} 封面`} width="1020" loading="eager" />}
        <div class="prose">
			<slot />
		</div>
		<Comments />
        <p class="back"><a href="/blog">← 返回文章列表</a></p>
	</article>
</BaseLayout>
<style>
	.post-header {
		margin-bottom: 2rem;
	}
	.post-header h1 {
		font-size: 2rem;
		margin-bottom: 0.5rem;
	}
	.meta {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin: 0;
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}
	.hero {
		display: block;
		width: 100%;
		height: auto;
		margin: 0 0 2rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--bg-soft);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
	}
	.back {
		margin-top: 3rem;
		font-size: 0.95rem;
	}
</style>
