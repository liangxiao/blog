{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test 'tests/*.test.mjs'",
    "test:writing": "npm test",
    "obsidian:setup": "npm run plugin:build && node scripts/setup-obsidian.mjs",
    "media:login": "npm run cloudflare:login",
    "cloudflare:login": "wrangler login --scopes account:read user:read workers:write pages:write",
    "deploy": "node scripts/deploy.mjs",
    "plugin:build": "node scripts/build-plugin.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.1",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "wrangler": "^4.151.3",
    "yaml": "^2.9.1"
  }
}
